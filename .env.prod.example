# =============================================================================
# WebProtege Staging / Production Environment
# =============================================================================
#
# Template for non-local deployments behind an externally managed nginx
# reverse proxy that terminates TLS (e.g. puppet + letsencrypt on the host).
# Copy this file and edit values for the target environment:
#
#   cp .env.prod.example .env.staging      # or .env.prod
#
# Bring the stack up with the prod overlay:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.staging up -d
#
# This file assumes the external nginx forwards plain HTTP to the loopback
# port bound below.  Required external nginx config:
#   proxy_set_header Host              $host;
#   proxy_set_header X-Forwarded-Proto https;
#   proxy_set_header X-Forwarded-Host  $host;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   # plus websocket upgrade headers for /wsapps and
#   # client_max_body_size 300m (or higher) for file uploads.

# ---------------------------------------------------------------------------
# Public hostname — must match the cert on the external nginx.
# ---------------------------------------------------------------------------
SERVER_HOST=webprotege-staging.example.org

# ---------------------------------------------------------------------------
# Public URL scheme as seen by the browser, AFTER external TLS termination.
# Leave both at https/wss for a deployment fronted by HTTPS nginx; the
# application emits redirect URIs, websocket URLs, and OAuth issuer URIs
# built from these values.
# ---------------------------------------------------------------------------
PUBLIC_SCHEME=https
PUBLIC_WS_SCHEME=wss

# ---------------------------------------------------------------------------
# Loopback bind for the internal webprotege-nginx container.  The external
# nginx proxy_passes to this address.  Keep on 127.0.0.1 unless you
# specifically want the port reachable from another interface.
# ---------------------------------------------------------------------------
WEBPROTEGE_HTTP_BIND=127.0.0.1
WEBPROTEGE_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# MongoDB connection URI (default points at the bundled mongo container).
# ---------------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017/webprotege

# ---------------------------------------------------------------------------
# Keycloak bootstrap admin credentials.  Seeded into the H2 volume on first
# boot; rotation later requires the Keycloak admin UI (or a full volume
# reset).  Pick a strong password BEFORE first boot.
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=          # REQUIRED — generate a strong password

# ---------------------------------------------------------------------------
# Keycloak 'user-management' client secret.
#
# Chicken-and-egg on first boot: this client is created during the realm
# import, so the secret doesn't exist until Keycloak has started once.
# Bootstrap procedure:
#   1. Set a placeholder value (e.g. "bootstrap") below.
#   2. docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#        --env-file .env.staging up -d webprotege-keycloak
#   3. Wait for the keycloak service to become healthy.
#   4. Sign in to https://<SERVER_HOST>/keycloak/admin/ and copy the
#      secret from Clients -> user-management -> Credentials.
#   5. Put it here and bring up the rest of the stack.
# ---------------------------------------------------------------------------
ADMIN_CLI_SECRET=                 # REQUIRED — retrieve from Keycloak admin UI

# ---------------------------------------------------------------------------
# MinIO root credentials.  Used by MinIO itself and by every WebProtege
# service that reads/writes objects.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=webprotege
MINIO_ROOT_PASSWORD=              # REQUIRED — generate a strong password

# Keycloak log level. Set to DEBUG to troubleshoot realm import or auth flows.
# KC_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Java remote debugging.
#
# MUST remain unset in any deployment reachable beyond the host loopback.
# JDWP has no authentication — anyone who can reach the port can execute
# arbitrary code in the service JVM.  The prod overlay also drops the
# debug host port bindings, but leave ENABLE_JAVA_DEBUG unset for defence
# in depth.
# ---------------------------------------------------------------------------
# ENABLE_JAVA_DEBUG=
